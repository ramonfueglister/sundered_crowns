# Sundered Crowns – environment variables. Copy to .env (never commit .env). No secrets in this file.
# Without any of these, the game is a complete single-player game and online features say "not configured".

# ---------------------------------------------------------------- browser build (Vite) – public values only
# Supabase project URL and the anon (public) key: Dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: OAuth providers enabled in Supabase Auth, comma separated (e.g. github,google). Empty = magic link only.
VITE_SUPABASE_OAUTH=
# World server WebSocket URL (wss:// in production).
VITE_WORLD_URL=ws://localhost:8787

# ---------------------------------------------------------------- world server (server/main.ts) – keep secret
# Leave SUPABASE_* empty for DEV mode (display-name login, local files only – never expose DEV mode publicly).
SUPABASE_URL=
# Service role key: bypasses Row Level Security. Only ever on the world server, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Verify player tokens either with the legacy JWT secret (HS256) …
SUPABASE_JWT_SECRET=
# … or with the project's signing keys (JWKS). Defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json when
# SUPABASE_URL is set and SUPABASE_JWT_SECRET is empty.
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUD=authenticated
# Public wss:// URL of this server (written to public.worlds.server_url so clients find it).
PUBLIC_WORLD_URL=
# Allowed browser origins for the WebSocket, comma separated (empty = any). E.g. https://sundered-crowns.vercel.app
ALLOWED_ORIGINS=
PORT=8787

# World and season
WORLD_ID=europa-1
WORLD_NAME=Europa I
WORLD_DATA_DIR=./world-data
WORLD_SEED=1356
WORLD_START_YEAR=1356
# Real seconds per in-game day. 36 → 1356–1815 (168,013 days) takes 70.0 real days = 10 weeks. 0.05 = fast test mode.
SECONDS_PER_DAY=36
SNAPSHOT_EVERY_DAYS=30
SNAPSHOT_UPLOAD_EVERY_DAYS=300
MAX_PLAYERS=100
# In-game days during which the AI will not declare war on a newly seated player.
PROTECTION_DAYS=30
# Real days without a login after which a seat goes back to the AI.
INACTIVE_RELEASE_DAYS=7
# Real hours a diplomatic offer between players stays open.
OFFER_EXPIRY_HOURS=48
# Orders a player may queue per in-game day.
CMDS_PER_DAY=60
# Extra admins by Supabase user id (comma separated). Admins can also be granted in public.admin_roles.
ADMIN_USERS=
# Testing only: end the season at this in-game day instead of 31 December 1815.
SEASON_END_DAY=
