{
  "name": "sundered-crowns",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "world": "tsx server/main.ts",
    "map": "cd tools/geo && python3 build_rasters.py && python3 build_locations.py && python3 build_setup.py",
    "world:fast": "SECONDS_PER_DAY=0.05 tsx server/main.ts",
    "land": "cd tools/geo && python3 build_land.py && cd ../.. && tsx tools/sim/calibrate_cultivation.ts",
    "harvest:check": "tsx tools/sim/harvest_check.ts",
    "economy:build": "tsx tools/sim/build_economy.ts",
    "economy:calibrate": "tsx tools/sim/calibrate_economy.ts",
    "economy:check": "tsx tools/sim/economy_check.ts",
    "people:check": "tsx tools/sim/people_check.ts",
    "deaths:check": "tsx tools/sim/deaths_check.ts",
    "lots:write": "tsx tools/sim/write_lots.ts",
    "portrait:build": "tsx tools/portrait/build_portrait.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "@supabase/supabase-js": "^2.119.0",
    "fflate": "^0.8.3",
    "preact": "^11.2.0",
    "three": "^0.187.0",
    "ws": "^8.22.2"
  }
}
