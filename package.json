{
  "name": "sundered-crowns",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "world": "tsx server/main.ts",
    "map": "cd tools/geo && python3 build_rasters.py && python3 build_locations.py && python3 build_setup.py",
    "world:fast": "SECONDS_PER_DAY=0.05 tsx server/main.ts",
    "smoke:online": "tsx tools/online_smoke.ts",
    "test:accept": "vitest run tests/acceptance.test.ts",
    "test:accept:slow": "ACCEPT_YEARS=50 vitest run tests/acceptance.test.ts",
    "observer": "tsx tools/sim/observer.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "@supabase/supabase-js": "^2.119.0",
    "fflate": "^0.8.3",
    "preact": "^11.2.0",
    "three": "^0.187.0",
    "ws": "^8.22.2"
  }
}
